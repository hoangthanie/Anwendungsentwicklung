# ① Qualitäts-Gate für jeden Push/PR – AP 4.3 (SJ). Kein LLM, nur synthetische Testdaten.
# Abnahme AP 4.3: „Pipeline läuft bei jedem PR grün/rot“. Job-Namen = Required Checks im Branch-Schutz.
name: ci

on:
  push:
    branches: [main]
  pull_request:

concurrency:
  group: ci-${{ github.ref }}
  cancel-in-progress: true

permissions:
  contents: read

env:
  PYTHON_VERSION: "3.11"

jobs:
  lint:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-python@v5
        with: { python-version: "${{ env.PYTHON_VERSION }}", cache: pip }
      - run: pip install -e ".[dev]"
      - name: ruff (Lint + bandit-Regeln)
        run: ruff check . --output-format=github
      - name: Formatierung
        run: ruff format --check .
      - name: mypy
        run: mypy src

  contracts:            # AP 3.3 / 3.4 – Vertrags-Tests
    needs: lint
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-python@v5
        with: { python-version: "${{ env.PYTHON_VERSION }}", cache: pip }
      - run: pip install -e ".[dev]"
      - name: Alle Artefakte im Repo validieren
        run: |
          for a in artefakte/*/artefakt.yaml; do dashframe-run "$a" --nur-pruefen; done
      - name: Modell-Tests
        run: pytest tests/test_models.py

  unit:                 # AP 8.2 – Unit-Tests
    needs: lint
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-python@v5
        with: { python-version: "${{ env.PYTHON_VERSION }}", cache: pip }
      - run: pip install -e ".[dev]"
      - run: pytest --cov=dashboard_framework --cov-report=term --cov-report=xml
      - uses: actions/upload-artifact@v4
        with: { name: coverage, path: coverage.xml }

  security:             # AP 4.6 – Sicherheitskonzept
    needs: lint
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
        with: { fetch-depth: 0 }
      - uses: actions/setup-python@v5
        with: { python-version: "${{ env.PYTHON_VERSION }}", cache: pip }
      - run: pip install -e ".[dev]" pip-audit
      - name: Nur-Lese-SQL-Tests
        run: pytest tests/test_validators.py
      - name: Abhängigkeiten auf bekannte Schwachstellen prüfen
        run: pip-audit --skip-editable
      - name: Secrets-Scan
        uses: gitleaks/gitleaks-action@v2
        env:
          GITHUB_TOKEN: ${{ secrets.GITHUB_TOKEN }}

  generizitaet:         # AP 7.4 / Risiko R06
    needs: lint
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-python@v5
        with: { python-version: "${{ env.PYTHON_VERSION }}" }
      - run: pip install pyyaml
      - run: bash scripts/generizitaet_check.sh

  stories:              # AP 8.1 – jede Anforderung hat einen Test (Rückverfolgbarkeit)
    needs: lint
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-python@v5
        with: { python-version: "${{ env.PYTHON_VERSION }}", cache: pip }
      - run: pip install -e ".[dev]"
      - run: pytest --story-status build/story_status.json
      - name: Jedes Akzeptanzkriterium hat einen Test
        run: python scripts/rueckverfolgbarkeit.py --pruefen
      - name: Status-Matrix in die Job-Zusammenfassung
        run: cat docs/stories/RUECKVERFOLGBARKEIT.md >> "$GITHUB_STEP_SUMMARY"

