  "narrative": {
    "northStar": "Das geprüfte Formblatt",
    "overview": "Jede Oberfläche ist ein Blatt, das jemand geprüft hat: oben ein Schriftfeld, darunter beschriftete, nummerierte Felder in Haarlinien. Ruhig und genau, ohne Papier nachzuahmen: keine Texturen, Schatten oder Verläufe. Die Kundenfarbe ist Gast und erscheint nur im aktiven Tab, in der Hauptaktion und in der Datenebene.",
    "keyCharacteristics": [
      "Schriftfeld als Kopf, Felder mit Nummer und Haarlinien",
      "Barlow plus Barlow Condensed",
      "Fester heller Grund: Papier mit weißen Blättern",
      "Zustände mit Form und Text",
      "Kundenfarbe reserviert"
    ],
    "rules": [
      {
        "name": "The Gast-Farbe Rule",
        "body": "Die Kundenfarbe taucht nur im aktiven Tab, in der Hauptaktion und in der Datenebene auf. Nie als Fläche der Oberfläche.",
        "section": "colors"
      },
      {
        "name": "The Form-und-Text Rule",
        "body": "Jeder Zustand hat Form und Text. Farbe allein trägt nie eine Aussage.",
        "section": "colors"
      },
      {
        "name": "The Eine-Skala Rule",
        "body": "Hierarchie entsteht aus Größe und Gewicht innerhalb einer Familie, nicht aus zusätzlichen Schriften.",
        "section": "typography"
      },
      {
        "name": "The Flach-Immer Rule",
        "body": "Keine Schatten, keine Verläufe, kein Glas.",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do jede neue Oberfläche mit einem Schriftfeld beginnen und in nummerierte Felder gliedern, wenn die Reihenfolge oder ein Verweis Information trägt.",
      "Do Meldungen am betroffenen Feld und gesammelt zeigen, in einfachen Wörtern.",
      "Do Zahlen deutsch schreiben (103,2; 300.000) und tabellarische Ziffern nutzen.",
      "Do Kontrast messen: Text mindestens 4,5:1, Ränder von Bedienelementen mindestens 3:1."
    ],
    "donts": [
      "Don't Streamlits Grau-mit-Farbakzent als Gestaltung gelten lassen.",
      "Don't farbige Seitenstreifen an Meldungen, Schatten, Verläufe oder Piktogramm-Zeichen als Icons verwenden.",
      "Don't eine Beschriftung über eine Überschrift setzen.",
      "Don't zwei Datenfarben für dieselbe Aussage verwenden.",
      "Don't fremde Texte ungeprüft in HTML oder CSS einsetzen."
    ]
  }
