      "html": "<div class=\"ds-sf\"><div class=\"ds-sf-z\"><span class=\"ds-sf-w ds-sf-titel\">Vertriebs-Dashboard</span></div><div class=\"ds-sf-z\"><span class=\"ds-sf-l\">Kunde</span><span class=\"ds-sf-w\">Muster GmbH</span></div><div class=\"ds-sf-z\"><span class=\"ds-sf-l\">Datenstand</span><span class=\"ds-sf-w\">15.12.2026</span></div><div class=\"ds-sf-z\"><span class=\"ds-sf-l\">Zeilen</span><span class=\"ds-sf-w\">192</span></div></div>",
      "css": ".ds-sf{display:grid;grid-template-columns:1.7fr 1fr 1fr 1fr;border:1.5px solid #1C2227;background:#fff;width:640px}.ds-sf-z{padding:10px 14px 12px;border-right:1px solid #AEB7BF}.ds-sf-z:last-child{border-right:0}.ds-sf-l{display:block;font:600 12px/1 'Barlow Condensed',sans-serif;letter-spacing:.09em;text-transform:uppercase;color:#4A545D;margin-bottom:7px}.ds-sf-w{display:block;font:600 18px/1.25 Barlow,sans-serif;color:#1C2227}.ds-sf-titel{font:600 26px/1.15 'Barlow Condensed',sans-serif}"
