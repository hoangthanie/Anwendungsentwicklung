      "html": "<div class=\"ds-feld\"><div class=\"ds-feld-kopf\"><span class=\"ds-nr\">1</span><span class=\"ds-feldtitel\">Umsatz nach Region</span></div><div class=\"ds-feld-inhalt\">Inhalt des Felds</div><div class=\"ds-fuss\"><div><span class=\"ds-sf-l\">Berechnung</span><span class=\"ds-fuss-w\">Summe von umsatz, gruppiert nach region.</span></div><div><span class=\"ds-sf-l\">Ergebnis</span><span class=\"ds-fuss-w\">4 Zeilen</span></div></div></div>",
      "css": ".ds-feld{background:#fff;border:1px solid #AEB7BF;border-radius:2px;width:420px}.ds-feld-kopf{display:flex;align-items:center;gap:12px;padding:12px 16px 10px;border-bottom:1px solid #DDE2E6}.ds-nr{font:600 13px/1 'Barlow Condensed',sans-serif;letter-spacing:.06em;background:#1C2227;color:#fff;padding:4px 7px 3px;border-radius:1px}.ds-feldtitel{font:600 21px/1.1 'Barlow Condensed',sans-serif;color:#1C2227}.ds-feld-inhalt{padding:16px;font:16px/1.5 Barlow,sans-serif;color:#1C2227}.ds-fuss{display:flex;border-top:1px solid #DDE2E6}.ds-fuss>div{flex:1;padding:8px 16px 10px;border-right:1px solid #DDE2E6}.ds-fuss>div:last-child{border-right:0}.ds-sf-l{display:block;font:600 12px/1 'Barlow Condensed',sans-serif;letter-spacing:.09em;text-transform:uppercase;color:#4A545D;margin-bottom:7px}.ds-fuss-w{font:500 15px/1.3 Barlow,sans-serif}"
    },
