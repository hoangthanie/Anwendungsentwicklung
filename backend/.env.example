# Vorlage: nach .env kopieren. Die .env wird nicht eingecheckt.
# Adresse des Ollama-Servers auf dem Entwicklungsrechner
OLLAMA_URL=http://localhost:11434
# Standardmodell für die Pipeline-Schritte (siehe docs/adr/0006-modellwahl.md)
MODELL=qwen3:8b
# Ausweichmodell, wenn die Antwort abgeschnitten oder kein gültiges JSON ist (leer = kein Fallback).
# Noch vom Team zu bestätigen, siehe docs/adr/0006-modellwahl.md
FALLBACK_MODELL=qwen3:14b
